PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/riz_db?schema=public
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-public-bucket-url.com
PAYMENT_MODE=mock

# --- Admin order notifications (WhatsApp Cloud API + Resend). Leave blank to disable a channel. ---
# Meta WhatsApp Cloud API (official). Keep these on the server only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A currently supported Graph API version from Meta's changelog, e.g. v23.0
WHATSAPP_API_VERSION=
# Admin's WhatsApp number: international format, digits only (no +, spaces or dashes)
ADMIN_WHATSAPP_NUMBER=
# Optional (defaults shown) - must match the approved template. See docs/whatsapp-admin-order-template.md
WHATSAPP_ORDER_TEMPLATE_NAME=riz_admin_new_order
# Optional wholesale template override. See docs/whatsapp-admin-wholesale-template.md
WHATSAPP_WHOLESALE_TEMPLATE_NAME=riz_admin_new_wholesale_enquiry
WHATSAPP_TEMPLATE_LANGUAGE=en
# Resend (admin emails only; customer emails still use the existing SMTP service)
RESEND_API_KEY=
# NOTE: ADMIN_EMAIL / EMAIL_FROM are also read by the existing SMTP notification code. EMAIL_FROM must be an
# address on your Resend-verified domain, e.g. "RIZ Orders <orders@yourdomain.com>". ADMIN_EMAIL may be comma-separated.
ADMIN_EMAIL=
EMAIL_FROM=
# Optional: use this instead of EMAIL_FROM for Resend only (keeps the existing SMTP code's EMAIL_FROM usage untouched)
RESEND_EMAIL_FROM=
